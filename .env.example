# Copy to .env.local for local work. On Vercel, add the same names under Project -> Settings -> Environment Variables.
# Vite only exposes variables that start with VITE_, and they end up in the public JavaScript bundle.

# --- Production: Supabase (Project Settings -> API) ---
# URL looks like https://abcdxyz.supabase.co. Use the "anon" / publishable key. NEVER put the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Local development fallback (used only when the Supabase values above are empty) ---
# The dev server runs a tiny collector at /api/* that writes to ./data (see server/collector.js).
VITE_DEMO_ENDPOINT=
VITE_FEEDBACK_ENDPOINT=

# Contact email shown in the footer (empty = placeholder text). Product name defaults to "DCE".
VITE_BRAND_NAME=
VITE_CONTACT_EMAIL=

# Set to "true" to show "wording to confirm" markers on feature copy.
VITE_SHOW_REVIEW_MARKERS=
